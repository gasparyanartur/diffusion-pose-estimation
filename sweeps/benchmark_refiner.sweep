# Inference parameter sweep for the diffusion refiner.
# One-factor-at-a-time (OFAT) design: 9 tasks.
# Baseline: steps=1, noise-frac=0.2, passes=1, cfg=1.0  (task 1)
# Each subsequent section varies one parameter while the rest stay at baseline.
#
# Run one task:
#   scripts/run_benchmark_sweep.sh sweeps/benchmark_refiner.sweep <task_id> \
#       <checkpoint> <pred_cache> <ann_file>
#
# Run all tasks:
#   scripts/run_benchmark_sweep.sh sweeps/benchmark_refiner.sweep --all \
#       <checkpoint> <pred_cache> <ann_file>

# baseline
--steps 1 --noise-frac 0.2 --passes 1 --cfg-guidance-scale 1.0
# steps
--steps 2 --noise-frac 0.2 --passes 1 --cfg-guidance-scale 1.0
--steps 4 --noise-frac 0.2 --passes 1 --cfg-guidance-scale 1.0
# noise-frac
--steps 1 --noise-frac 0.4 --passes 1 --cfg-guidance-scale 1.0
--steps 1 --noise-frac 0.6 --passes 1 --cfg-guidance-scale 1.0
# passes
--steps 1 --noise-frac 0.2 --passes 2 --cfg-guidance-scale 1.0
--steps 1 --noise-frac 0.2 --passes 3 --cfg-guidance-scale 1.0
# cfg-guidance-scale
--steps 1 --noise-frac 0.2 --passes 1 --cfg-guidance-scale 2.0
--steps 1 --noise-frac 0.2 --passes 1 --cfg-guidance-scale 4.0
